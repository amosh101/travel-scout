# Travel Scout v2 - environment variables (template)
# Copy to .env (gitignored) and fill real values. NEVER commit a real .env.

ENV=development
LOG_LEVEL=INFO
APP_NAME=travel-scout

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://100.91.143.50:3000

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_me_with_openssl_rand_hex_32

# Async SQLAlchemy URL (asyncpg for prod, aiosqlite for tests).
DATABASE_URL=postgresql+asyncpg://travel_scout:travel_scout_dev@postgres:5432/travel_scout
DATABASE_URL_SYNC=postgresql+psycopg2://travel_scout:travel_scout_dev@postgres:5432/travel_scout
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
STRIPE_SECRET_KEY=replace_me_sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=replace_me_whsec_from_stripe_cli

# Read at runtime by client factories. Empty/missing = not configured error, never fake data.
KIWI_API_KEY=
TICKETMASTER_API_KEY=
JOLPICA_API_KEY=

# Admin routes only accept requests from these CIDRs (Tailscale VPN).
ADMIN_ALLOWED_CIDRS=100.64.0.0/10,100.91.143.50/32

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Travel Scout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_me_pk_test_or_pk_live
# --- Transactional delivery (2026-10-21): leave empty to skip honestly ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Travel Scout <no-reply@example.com>"
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Stripe subscription price ids (Checkout) ---
STRIPE_PRICE_LIMITED=
STRIPE_PRICE_UNLIMITED=
STRIPE_PRICE_CONCIERGE=
WEB_BASE_URL=http://100.91.143.50:3000

# --- Weekly digest scheduler ---
DIGESTS_ENABLED=true
DIGEST_WINDOW_DAYS=30
DIGEST_MAX_RESULTS=3
DIGEST_CHECK_INTERVAL_S=300
